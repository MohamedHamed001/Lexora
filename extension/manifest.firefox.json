{
  "manifest_version": 3,
  "name": "Lexora",
  "version": "1.7.0",
  "description": "AI-powered study companion for any page.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "optional_permissions": ["webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["protocol.js", "storage.js", "capture-extractor.js", "capture-clean.js", "background.js"]
  },
  "action": {
    "default_title": "AI-Study Companion",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon48.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidepanel/sidepanel.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lexora-companion@hamed.ai",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel/sidepanel.html",
    "default_title": "Lexora Study Companion",
    "default_icon": "icons/icon48.png"
  }
}
